{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "automationApiVersion": {
      "type": "String",
      "defaultValue": "2024-10-23"
    },
    "subscriptionId": {
      "type": "String"
    },
    "resourceGroupName": {
      "type": "String"
    },
    "automationAccountName": {
      "type": "String"
    },
    "runbookName": {
      "type": "String"
    },
    "storageAccountName": {
      "type": "String"
    },
    "storageContainerName": {
      "type": "String"
    },
    "exportRootPath": {
      "type": "String"
    }
  },
  "triggers": {
    "Recurrence": {
      "type": "Recurrence",
      "recurrence": {
        "frequency": "Day",
        "interval": 1,
        "timeZone": "UTC",
        "schedule": {
          "hours": [
            0
          ],
          "minutes": [
            0
          ]
        }
      }
    }
  },
  "actions": {
    "Create_Job": {
      "type": "Http",
      "inputs": {
        "method": "PUT",
        "uri": "@{concat('https://management.azure.com/subscriptions/', parameters('subscriptionId'), '/resourceGroups/', parameters('resourceGroupName'), '/providers/Microsoft.Automation/automationAccounts/', parameters('automationAccountName'), '/jobs/', guid(workflow().run.name), '?api-version=', parameters('automationApiVersion'))}",
        "headers": {
          "Content-Type": "application/json"
        },
        "authentication": {
          "type": "ManagedServiceIdentity",
          "audience": "https://management.azure.com/"
        },
        "body": {
          "properties": {
            "runbook": {
              "name": "@{parameters('runbookName')}"
            },
            "parameters": {
              "StorageAccountName": "@{parameters('storageAccountName')}",
              "StorageContainerName": "@{parameters('storageContainerName')}",
              "ExportRootPath": "@{parameters('exportRootPath')}"
            }
          }
        }
      },
      "runAfter": {}
    },
    "Initialize_JobStatus": {
      "type": "InitializeVariable",
      "inputs": {
        "variables": [
          {
            "name": "JobStatus",
            "type": "string",
            "value": "@{body('Create_Job')?['properties']?['status']}"
          }
        ]
      },
      "runAfter": {
        "Create_Job": [
          "Succeeded"
        ]
      }
    },
    "Wait_For_Job": {
      "type": "Until",
      "expression": "@or(equals(variables('JobStatus'), 'Completed'), equals(variables('JobStatus'), 'Failed'), equals(variables('JobStatus'), 'Stopped'), equals(variables('JobStatus'), 'Suspended'), equals(variables('JobStatus'), 'Blocked'))",
      "limit": {
        "count": 240,
        "timeout": "PT4H"
      },
      "actions": {
        "Delay_30s": {
          "type": "Wait",
          "inputs": {
            "interval": {
              "count": 30,
              "unit": "Second"
            }
          }
        },
        "Get_Job": {
          "type": "Http",
          "inputs": {
            "method": "GET",
            "uri": "@{concat('https://management.azure.com/subscriptions/', parameters('subscriptionId'), '/resourceGroups/', parameters('resourceGroupName'), '/providers/Microsoft.Automation/automationAccounts/', parameters('automationAccountName'), '/jobs/', guid(workflow().run.name), '?api-version=', parameters('automationApiVersion'))}",
            "authentication": {
              "type": "ManagedServiceIdentity",
              "audience": "https://management.azure.com/"
            }
          },
          "runAfter": {
            "Delay_30s": [
              "Succeeded"
            ]
          }
        },
        "Set_JobStatus": {
          "type": "SetVariable",
          "inputs": {
            "name": "JobStatus",
            "value": "@{body('Get_Job')?['properties']?['status']}"
          },
          "runAfter": {
            "Get_Job": [
              "Succeeded"
            ]
          }
        }
      },
      "runAfter": {
        "Initialize_JobStatus": [
          "Succeeded"
        ]
      }
    },
    "Job_Result": {
      "type": "If",
      "expression": {
        "equals": [
          "@variables('JobStatus')",
          "Completed"
        ]
      },
      "actions": {
        "Return_Success": {
          "type": "Compose",
          "inputs": {
            "status": "Completed",
            "message": "Intune export runbook completed.",
            "jobId": "@{body('Create_Job')?['properties']?['jobId']}"
          }
        }
      },
      "else": {
        "actions": {
          "Fail_Workflow": {
            "type": "Terminate",
            "inputs": {
              "runStatus": "Failed",
              "runError": {
                "code": "RunbookJobFailed",
                "message": "@{concat('Runbook job status: ', variables('JobStatus'))}"
              }
            }
          }
        }
      },
      "runAfter": {
        "Wait_For_Job": [
          "Succeeded"
        ]
      }
    }
  },
  "outputs": {}
}
