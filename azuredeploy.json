{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "location": {
      "type": "string",
      "defaultValue": "[resourceGroup().location]",
      "metadata": {
        "description": "Resource location"
      }
    },
    "prefix": {
      "type": "string",
      "defaultValue": "intunex",
      "maxLength": 12,
      "metadata": {
        "description": "Solution prefix used in resource names"
      }
    },
    "automationAccountName": {
      "type": "string",
      "defaultValue": "intunex-aa",
      "metadata": {
        "description": "Automation account name"
      }
    },
    "logicAppName": {
      "type": "string",
      "defaultValue": "intunex-la",
      "metadata": {
        "description": "Logic App (Consumption) name"
      }
    },
    "runbookName": {
      "type": "string",
      "defaultValue": "Export-IntuneConfiguration",
      "metadata": {
        "description": "Runbook name"
      }
    },
    "storageAccountName": {
      "type": "string",
      "defaultValue": "[toLower(format('intune{0}', uniqueString(resourceGroup().id)))]",
      "minLength": 3,
      "maxLength": 24,
      "metadata": {
        "description": "Storage account name (3-24 lowercase letters/numbers)"
      }
    },
    "storageContainerName": {
      "type": "string",
      "defaultValue": "intune-exports",
      "metadata": {
        "description": "Blob container name"
      }
    },
    "exportRootPath": {
      "type": "string",
      "defaultValue": "daily",
      "minLength": 1,
      "metadata": {
        "description": "Blob root path prefix"
      }
    },
    "retentionDays": {
      "type": "int",
      "defaultValue": 365,
      "minValue": 30,
      "maxValue": 3650,
      "metadata": {
        "description": "Retention in days for lifecycle cleanup"
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "intunePolicyExportMain",
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "relativePath": "infra/main.json"
        },
        "parameters": {
          "location": {
            "value": "[parameters('location')]"
          },
          "prefix": {
            "value": "[parameters('prefix')]"
          },
          "automationAccountName": {
            "value": "[parameters('automationAccountName')]"
          },
          "logicAppName": {
            "value": "[parameters('logicAppName')]"
          },
          "runbookName": {
            "value": "[parameters('runbookName')]"
          },
          "storageAccountName": {
            "value": "[parameters('storageAccountName')]"
          },
          "storageContainerName": {
            "value": "[parameters('storageContainerName')]"
          },
          "exportRootPath": {
            "value": "[parameters('exportRootPath')]"
          },
          "retentionDays": {
            "value": "[parameters('retentionDays')]"
          }
        }
      }
    }
  ],
  "outputs": {
    "storageAccountResourceId": {
      "type": "string",
      "value": "[reference('intunePolicyExportMain').outputs.storageAccountResourceId.value]"
    },
    "automationAccountResourceId": {
      "type": "string",
      "value": "[reference('intunePolicyExportMain').outputs.automationAccountResourceId.value]"
    },
    "automationPrincipalId": {
      "type": "string",
      "value": "[reference('intunePolicyExportMain').outputs.automationPrincipalId.value]"
    },
    "logicAppResourceId": {
      "type": "string",
      "value": "[reference('intunePolicyExportMain').outputs.logicAppResourceId.value]"
    },
    "logicAppPrincipalId": {
      "type": "string",
      "value": "[reference('intunePolicyExportMain').outputs.logicAppPrincipalId.value]"
    }
  }
}
