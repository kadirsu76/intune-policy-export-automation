{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "baseName": {
      "type": "string",
      "defaultValue": "intunex",
      "minLength": 3,
      "maxLength": 20,
      "metadata": {
        "description": "Single base name used to derive resource names, for example intunex => aa-intunex, sch-intunex-daily"
      }
    },
    "exportRootPath": {
      "type": "string",
      "defaultValue": "daily",
      "minLength": 1,
      "metadata": {
        "description": "Blob root path prefix"
      }
    },
    "retentionDays": {
      "type": "int",
      "defaultValue": 365,
      "minValue": 30,
      "maxValue": 3650,
      "metadata": {
        "description": "Retention in days for lifecycle cleanup"
      }
    }
  },
  "resources": [
    {
      "type": "Microsoft.Resources/deployments",
      "apiVersion": "2022-09-01",
      "name": "intunePolicyExportMain",
      "properties": {
        "mode": "Incremental",
        "templateLink": {
          "relativePath": "infra/main.json"
        },
        "parameters": {
          "baseName": {
            "value": "[parameters('baseName')]"
          },
          "exportRootPath": {
            "value": "[parameters('exportRootPath')]"
          },
          "retentionDays": {
            "value": "[parameters('retentionDays')]"
          }
        }
      }
    }
  ],
  "outputs": {
    "storageAccountResourceId": {
      "type": "string",
      "value": "[reference('intunePolicyExportMain').outputs.storageAccountResourceId.value]"
    },
    "storageAccountName": {
      "type": "string",
      "value": "[reference('intunePolicyExportMain').outputs.storageAccountNameOut.value]"
    },
    "automationAccountResourceId": {
      "type": "string",
      "value": "[reference('intunePolicyExportMain').outputs.automationAccountResourceId.value]"
    },
    "automationAccountName": {
      "type": "string",
      "value": "[reference('intunePolicyExportMain').outputs.automationAccountNameOut.value]"
    },
    "automationPrincipalId": {
      "type": "string",
      "value": "[reference('intunePolicyExportMain').outputs.automationPrincipalId.value]"
    },
    "runbookName": {
      "type": "string",
      "value": "[reference('intunePolicyExportMain').outputs.runbookNameOut.value]"
    },
    "scheduleResourceId": {
      "type": "string",
      "value": "[reference('intunePolicyExportMain').outputs.scheduleResourceId.value]"
    },
    "scheduleName": {
      "type": "string",
      "value": "[reference('intunePolicyExportMain').outputs.scheduleNameOut.value]"
    }
  }
}
